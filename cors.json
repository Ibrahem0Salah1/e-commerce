{
  "rules": [
    {
      "allowed": {
        "origins": [
          "http://localhost:3000",
          "https://mds-woad.vercel.app"
        ],
        "methods": [
          "GET",
          "PUT",
          "POST",
          "DELETE",
          "HEAD"
        ],
        "headers": [
          "*"
        ]
      },
      "exposeHeaders": [
        "ETag"
      ],
      "maxAgeSeconds": 300
    }
  ]
}