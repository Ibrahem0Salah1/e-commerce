generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  FAILED
}

enum PaymentMethod {
  COD
}

// ─────────────────────────────────────────
// AUTH TABLES (Better Auth required shape)
// ─────────────────────────────────────────

model User {
  id               String     @id @default(cuid())
  name             String
  email            String     @unique
  emailVerified    Boolean    @default(false)
  image            String?
  phone            String?
  role             Role       @default(USER)
  status           UserStatus @default(ACTIVE)
  banned           Boolean    @default(false)
  banReason        String?
  banExpires       DateTime?
  twoFactorEnabled Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  sessions  Session[]
  accounts  Account[]
  twoFactor TwoFactor?
  orders    Order[]
  cartItems CartItem[]
  reviews   Review[]

  @@map("users")
}

model Session {
  id             String   @id @default(cuid())
  userId         String
  token          String   @unique
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model TwoFactor {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  secret                  String
  backupCodes             String
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@map("two_factors")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

// ─────────────────────────────────────────
// CATALOG
// ─────────────────────────────────────────

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  image       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
  families ProductFamily[]

  @@map("categories")
}

model Brand {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logo        String? // URL to brand logo image
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@map("brands")
}

model ProductFamily {
  id         String    @id @default(cuid())
  name       String
  slug       String    @unique
  isActive   Boolean   @default(true)
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id])
  products   Product[]

  @@unique([categoryId, name])
  @@index([categoryId])
  @@map("product_families")
}

model Product {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String[]
  madeIn        String?
  price         Decimal  @db.Decimal(10, 2)
  costPrice     Decimal? @db.Decimal(10, 2) // ← NEW
  marginPercent Decimal? @db.Decimal(5, 2) // ← NEW
  stock         Int      @default(0)
  sku           String?  @unique
  images        String[]
  categoryId    String
  familyId      String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  archived      Boolean  @default(false)
  featured      Boolean  @default(false)
  bestSeller    Boolean  @default(false)

  category        Category                @relation(fields: [categoryId], references: [id])
  family          ProductFamily?          @relation(fields: [familyId], references: [id])
  brand           Brand?                  @relation(fields: [brandId], references: [id])
  brandId         String?
  specGroups      SpecificationGroup[]
  reviews         Review[]
  attributeValues ProductAttributeValue[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  restocks        RestockEntry[]

  @@index([categoryId])
  @@index([familyId])
  @@index([brandId])
  @@index([isActive])
  @@map("products")
}

// ─────────────────────────────────────────
// ATTRIBUTE SYSTEM
// ─────────────────────────────────────────

model AttributeType {
  id           String @id @default(cuid())
  name         String @unique // "Size", "Color", "Shade", "Unit"
  slug         String @unique
  displayOrder Int? // NEW: nullable, controls name-building order

  values   AttributeValue[]
  products ProductAttributeValue[]

  @@map("attribute_types")
}

model AttributeValue {
  id              String                  @id @default(cuid())
  attributeTypeId String
  attributeType   AttributeType           @relation(fields: [attributeTypeId], references: [id])
  value           String // "Medium", "Blue", "A2", "Pack"
  slug            String
  products        ProductAttributeValue[]

  @@unique([attributeTypeId, value])
  @@map("attribute_values")
}

model ProductAttributeValue {
  id               String         @id @default(cuid())
  productId        String
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeTypeId  String // denormalized — needed for @@unique constraint
  attributeType    AttributeType  @relation(fields: [attributeTypeId], references: [id])
  attributeValueId String
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id])

  @@unique([productId, attributeTypeId]) // one value per attribute type per product
  @@map("product_attribute_values")
}

// ─────────────────────────────────────────
// RestockEntry[]
// ─────────────────────────────────────────
// Tracks restock events for a product, including quantity added and cost price at the time
model PurchaseInvoice {
  id            String         @id @default(cuid())
  supplierName  String?
  invoiceNumber String?
  supplierPhone String?
  createdAt     DateTime       @default(now())
  items         RestockEntry[]
  totalCost     Decimal        @db.Decimal(10, 2) // sum of all items' costPrice * quantityAdded

  @@index([createdAt]) // for filtering by date range in reports
  @@map("purchase_invoices")
}

model RestockEntry {
  id            String          @id @default(cuid())
  invoiceId     String
  invoice       PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId     String
  product       Product         @relation(fields: [productId], references: [id])
  costPrice     Decimal         @db.Decimal(10, 2)
  marginPercent Decimal         @db.Decimal(5, 2)
  sellingPrice  Decimal         @db.Decimal(10, 2)
  quantityAdded Int
  createdAt     DateTime        @default(now())

  @@index([productId])
  @@index([invoiceId])
  @@map("restock_entries")
}

// ─────────────────────────────────────────
// SPECIFICATIONS
// ─────────────────────────────────────────

// Groups specs into sections shown as accordions on the product page
// e.g. "Physical Properties", "Clinical", "Material", "Packaging"
model SpecificationGroup {
  id        String   @id @default(cuid())
  productId String
  name      String // "Physical Properties", "Clinical", "Material"
  position  Int // display order — lower = shown first
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  specs   Specification[]

  @@unique([productId, name]) // no duplicate group names per product
  @@index([productId, position])
  @@map("specification_groups")
}

model Specification {
  id        String   @id @default(cuid())
  groupId   String
  key       String // "Slot Size", "Max Load", "Cure Time"
  value     String // "0.022 inch", "180kg", "20s"
  position  Int // display order within the group
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group SpecificationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  //@@unique([groupId, key]) // no duplicate keys within the same group
  @@index([groupId, position])
  @@map("specifications")
}

// ─────────────────────────────────────────
// REVIEWS
// ─────────────────────────────────────────

model Review {
  id               String   @id @default(cuid())
  userId           String
  productId        String
  rating           Int // 1–5, enforced via Zod at API layer
  title            String?
  body             String?
  // set server-side — true if user has a DELIVERED order containing this product
  verifiedPurchase Boolean  @default(false)
  // admin can hide a review without deleting it
  isVisible        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId]) // one review per user per product
  @@index([productId])
  @@map("reviews")
}

// ─────────────────────────────────────────
// CART (logged-in users only)
// guests use Zustand + localStorage
// on login: merge localStorage cart into DB, clear localStorage
// ─────────────────────────────────────────

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@map("cart_items")
}

// ─────────────────────────────────────────
// COUPONS
// ─────────────────────────────────────────

model Coupon {
  id             String       @id @default(cuid())
  code           String       @unique // "DENTAL20", "WELCOME50"
  type           DiscountType
  value          Decimal      @db.Decimal(10, 2) // 20 = 20% or 20 EGP
  minOrderAmount Decimal?     @db.Decimal(10, 2) // minimum subtotal to apply coupon
  maxUses        Int? // null = unlimited
  usedCount      Int          @default(0)
  expiresAt      DateTime? // null = never expires
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  orders Order[]

  @@map("coupons")
}

// ─────────────────────────────────────────
// SHIPPING METHODS
// ─────────────────────────────────────────

model ShippingMethod {
  id        String   @id @default(cuid())
  name      String
  price     Decimal  @db.Decimal(10, 2)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@map("shipping_methods")
}

// ─────────────────────────────────────────
// ORDERS
// ─────────────────────────────────────────

model Order {
  id String @id @default(cuid())

  // userId null = guest order
  userId     String?
  guestEmail String?
  guestName  String?
  guestPhone String?

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)
  paymentMethod PaymentMethod @default(COD)
  paidAt        DateTime?

  // always calculated server-side — never trust client
  subtotal       Decimal @db.Decimal(10, 2)
  discountAmount Decimal @default(0) @db.Decimal(10, 2)
  total          Decimal @db.Decimal(10, 2)

  // coupon
  couponId   String?
  // denormalized — preserved if coupon is deleted later
  couponCode String?

  // shipping info inline
  shippingMethodId String?
  shippingPrice    Decimal @default(0) @db.Decimal(10, 2)
  shippingName     String
  shippingPhone    String
  shippingAddress  String
  shippingCity     String
  shippingNotes    String?
  idempotencyKey   String?   @unique
  guestAccessToken String? // hashed token stored server-side
  guestTokenExpiry DateTime? // tokens expire after 30 days
  cancelledAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user           User?           @relation(fields: [userId], references: [id])
  coupon         Coupon?         @relation(fields: [couponId], references: [id])
  shippingMethod ShippingMethod? @relation(fields: [shippingMethodId], references: [id])
  items          OrderItem[]

  @@index([userId])
  @@index([status, createdAt])
  @@index([shippingMethodId])
  @@index([paymentStatus, paidAt])
  @@index([paidAt])
  @@map("orders")
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String

  // denormalized snapshots — frozen at purchase time
  // so renames/price changes never affect historical orders
  productName     String
  variantName     String
  unitPrice       Decimal  @db.Decimal(10, 2)
  totalPrice      Decimal  @db.Decimal(10, 2) // unitPrice × quantity
  costPriceAtSale Decimal? @db.Decimal(10, 2) // snapshot of product.costPrice when this order was placed
  quantity        Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}
